# 对话模型：任意 OpenAI 兼容网关，必须支持 tool calling
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# 生图模型：POST {IMAGE_BASE_URL}/images/generations，兼容 OpenAI images 接口
# 不填 IMAGE_BASE_URL / IMAGE_API_KEY 时沿用上面 LLM 的值
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1536
# 生图最长等待秒数。实测 gpt-image-2.6-flare 出一张竖版图约 150 秒
IMAGE_TIMEOUT=600

# 电影元数据：https://www.themoviedb.org/settings/api （v3 key 或 v4 read token 都行）
TMDB_API_KEY=

# 可选：联网搜索。不填则用 DuckDuckGo（不稳定），填 Tavily key 更可靠
TAVILY_API_KEY=

# 可选：海报文字字体（需含中文字形）。不填则自动找系统字体
POSTER_FONT=

# 可选
DATA_DIR=
MAX_AGENT_STEPS=6
